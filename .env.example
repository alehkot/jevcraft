# ---- Required: one model key and a Minecraft server ------------------------

# Jev through TypeSafe. Get a key at https://typesafe.ai/
TYPESAFE_API_KEY=

# The Minecraft Java 26.1 server the bot joins, and the name it plays as.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Jev
# "offline" for a LAN/offline-mode server, "microsoft" for a real account.
MC_AUTH=offline

# ---- Optional: generative model for custom building designs and stuck recovery

# Creative mode only. With it, "Jev build a cherry mansion" in Creative gets a
# custom design; in Survival, or without it, Jev configures building templates.
OPENROUTER_API_KEY=
OPENROUTER_BUILD_MODEL=anthropic/claude-opus-5.5
# auto: custom designs in Creative when a key is set, templates otherwise.
# jev: always templates. openrouter: require custom designs in Creative.
# Survival always uses templates.
BUILD_DESIGNER=auto
# jev: Jev picks a code-checked recovery action after repeated failures.
# off: ordinary retries only.
RECOVERY_ADVISER=jev

# ---- Optional: everything else ---------------------------------------------

# Jev decisions can also go through OpenRouter instead of TypeSafe.
# JEV_PROVIDER=typesafe
# JEV_PROVIDER=openrouter
# OPENROUTER_JEV_MODEL=typesafe/jev-1.14   (the runs use 1.14; 1.13, the code default, died about three times as often)
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Pin the protocol version if auto-detection picks the wrong one.
# MC_VERSION=26.1
# A separate memory namespace when you replace the world at the same address.
# MC_WORLD_ID=my-survival-world

# What the bot does between requests. Unset: it looks after itself (food,
# shelter, supplies). wait: it stays where it stands and only answers what
# would hurt it there (lava, fire, drowning, a mob in reach).
# JEV_IDLE=wait

# ask: work one player gave is not replaced by another player's request until
# the first player says yes. Stop is never gated. Unset: any request replaces
# the work in hand.
# JEV_COOPERATION=ask

# A language model in front of the request interpreter, for guidance in plain
# words: standing rules ("from now on, wood means birch"), vague or two-step
# wishes, questions. It only produces chat lines and plain requests; it cannot
# run commands. Any OpenAI-compatible chat-completions endpoint. Off when the
# key is empty. Each chat message addressed to the bot is one small model call
# (about 950 tokens in, 45 out).
# JEV_GUIDE_API_KEY=
# JEV_GUIDE_URL=https://api.openai.com/v1/chat/completions
# Measured on 31 scripted cases (scripts/guide-eval.js, scripts/guide-eval-hard.js), five runs
# each (2026-11-20), on the instructions as they are now:
#   gpt-6.1-terra, reasoning low   155 of 155, median 1.3 s   (the default)
#   gpt-6-luna, reasoning none     154 of 155, median 1.0 s   (about a tenth of the price)
# gpt-4.1-mini scored 45 of 51 on an earlier, shorter set.
# JEV_GUIDE_MODEL=gpt-6.1-terra
# none, low, medium or high; empty sends none at all. A model that refuses the
# setting, or a temperature, is called again without it.
# JEV_GUIDE_REASONING=low
# JEV_GUIDE_TEMPERATURE=
# JEV_GUIDE_MAX_TOKENS=600
# JEV_GUIDE_PER_HOUR=60

# Players allowed to ask for server commands ("Jev make it daytime").
# Empty disables them. The bot also needs operator permission on the server.
MC_COMMAND_USERS=

# The bot records what it sees and decides to .bot-state/flight (kept a day)
# for the audits; set to 0 to turn that off.
# JEV_FLIGHT=1

# Development drills (scripts/arena.js, terrain.js, endgame.js): a player the
# drill puts in Spectator on the bot so a run can be watched. Leave empty to
# watch nothing.
# ARENA_WATCHER=YourPlayerName

# Trials: the player made an operator on every trial server, to spectate Jev.
# TRIAL_WATCHER=YourPlayerName
# Where ReplayMod recordings go for the death montage (default: a macOS PrismLauncher instance).
# REPLAY_RECORDINGS=/path/to/replay_recordings
